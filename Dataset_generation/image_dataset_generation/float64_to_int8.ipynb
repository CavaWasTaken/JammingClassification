    "dataset_path = \"C:/Users/loren/Downloads/array_dataset/array_dataset/antennina2/CLEAN\"\n",
    "\n",
    "save_folder = \"./image_dataset/CLEAN\"\n",
    "os.makedirs(save_folder, exist_ok=True)\n",
    "\n",
    "for file in os.listdir(dataset_path):\n",
    "\n",
    "    if file.endswith(\".npy\"):\n",
    "\n",
    "        file_path = os.path.join(dataset_path, file)\n",
    "\n",
    "        matrix_float64 = np.load(file_path)\n",
    "\n",
    "        matrix_int8 = convert_float64_to_int8(matrix_float64)\n",
    "\n",
    "        save_path = os.path.join(save_folder, file)\n",
    "\n",
    "        np.save(save_path, matrix_int8)\n",
    "\n",
    "        print(f\"Saved {save_path}\")"
