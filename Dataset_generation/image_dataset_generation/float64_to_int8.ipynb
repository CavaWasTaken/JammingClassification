   "metadata": {},
   "source": [
    "**Convert the dataset from float64 to int8 in Python using NumPy**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a36a11da",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "6fe6802b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def convert_float64_to_int8(matrix_npy):\n",
    "    matrix_int8 = ((matrix_npy - matrix_npy.min()) / (matrix_npy.max() - matrix_npy.min()) * 255 - 128).astype(np.int8)\n",
    "    return matrix_int8"
   ]
  },
